# Application
APP_NAME="SSO Server"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://auth.yourdomain.com
APP_KEY=

# Frontend
FRONTEND_URL=https://app.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=app.yourdomain.com

# WebAuthn (passkey): rp.id MUST be the frontend host (or a parent suffix),
# and allowed origins must include the frontend origin — otherwise registration
# fails with "'rp.id' cannot be used with the current origin".
PASSKEY_RP_ID=app.yourdomain.com
PASSKEY_ALLOWED_ORIGINS=https://app.yourdomain.com

# Locale
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sso
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_SAME_SITE=lax

# Cache
CACHE_STORE=database
CACHE_PREFIX=sso_

# JWT (RS256)
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_TOKEN_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=2592000
JWT_REFRESH_INACTIVITY=604800
JWT_ISSUER=https://auth.yourdomain.com

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Security
BCRYPT_ROUNDS=12

# Queue & Broadcast
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite
VITE_APP_NAME="${APP_NAME}"
