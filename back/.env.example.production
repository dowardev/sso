# Plantilla de configuración de producción para SSO Server
# Copiar a .env y completar con valores reales

# ============================================
# APLICACIÓN
# ============================================
APP_NAME=SSO Server
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sso.miapp.com

# GENERAR: php artisan key:generate --show
APP_KEY=tu_app_key_aqui

# ============================================
# LOCALIZACIÓN
# ============================================
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# ============================================
# MANTENIMIENTO
# ============================================
APP_MAINTENANCE_DRIVER=file

# ============================================
# SEGURIDAD
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# LOGS
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ============================================
# BASE DE DATOS (MySQL recomendado para producción)
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sso_server
DB_USERNAME=sso_user
DB_PASSWORD=tu_password_seguro_aqui

# ============================================
# SESIÓN
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.miapp.com

# ============================================
# COLAS Y CACHÉ
# ============================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=sso_

# ============================================
# REDIS (opcional)
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# CORREO (configurar según tu proveedor)
# ============================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.miapp.com
MAIL_PORT=587
MAIL_USERNAME=noreply@miapp.com
MAIL_PASSWORD=tu_mail_password_aqui
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@miapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# SANCTUM - CRÍTICO PARA PRODUCCIÓN
# ============================================
# Dominios que pueden usar cookies de sesión (si aplica)
# Incluye todos tus frontend y backends
SANCTUM_STATEFUL_DOMAINS=miapp.com,www.miapp.com,api.miapp.com

# (Opcional) Expiración de tokens en minutos
# SANCTUM_EXPIRATION=60

# ============================================
# OTROS SERVICIOS (AWS, etc.)
# ============================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
