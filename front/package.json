    "@ionic/vue-router": "^8.0.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "ionicons": "^7.0.0",
    "pinia": "^3.0.4",
    "ua-parser-js": "^2.0.10",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.0",
    "@eslint/js": "^9.39.1",
