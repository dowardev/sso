{
  "name": "sso",
  "version": "0.10.0",
  "private": true,
  "description": "SSO Server with Laravel backend and Ionic/Vue frontend",
  "workspaces": [
    "front",
    "back"
  ],
  "scripts": {
    "dev:front": "cd front && npm run dev",
    "dev:back": "cd back && php artisan serve",
    "dev": "concurrently \"npm:dev:front\" \"npm:dev:back\"",
    "build:front": "cd front && npm run build",
    "build:back": "cd back && php artisan build",
    "build": "npm run build:front && npm run build:back"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
