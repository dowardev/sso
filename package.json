{
  "name": "sso",
  "version": "0.32.1",
  "private": true,
  "description": "SSO Server with Laravel backend and Ionic/Vue frontend",
  "workspaces": [
    "front",
    "back",
    "packages/*"
  ],
  "scripts": {
    "dev:front": "pnpm --filter front dev",
    "dev:back": "cd back && php artisan serve",
    "dev": "concurrently \"pnpm:dev:front\" \"pnpm:dev:back\"",
    "build:front": "pnpm --filter front build",
    "build:back": "cd back && php artisan build",
    "build:sso-client": "pnpm --filter @dowardev/sso-client build",
    "build": "pnpm run build:front && pnpm run build:back"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "packageManager": "pnpm@11.3.0"
}
